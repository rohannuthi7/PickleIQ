# Copy this file to `.env` in the repo root. The backend loads it on startup
# (python-dotenv). Every variable is optional; commented values are the defaults.

# --- Anthropic -------------------------------------------------------------
# Needed only for the coaching report and the discrepancy report. Upload,
# processing, labelling and comparison work without it. On EC2 the key is read
# from AWS Secrets Manager instead (backend/app/secrets_bootstrap.py).
ANTHROPIC_API_KEY=
# ANTHROPIC_COACHING_MODEL=claude-sonnet-5
# ANTHROPIC_REPORT_MODEL=claude-haiku-4-5-20251001

# --- Inference -------------------------------------------------------------
# Device: auto | xpu | cuda | cpu (auto tries xpu, then cuda, then cpu).
# CV_DEVICE=auto
# Named bundle of per-machine speed settings from backend/app/hw_profiles.json.
# See docs/hardware-profiles.md.
# HW_PROFILE=
# YOLO pose weights for player detection.
# POSE_MODEL=yolo11n-pose.pt
# TrackNet ball tracker. Without weights, Pass 2 uses the classical detector.
# TRACKNET_ENABLED=0
# TRACKNET_WEIGHTS=
# Pass 2 ball detection.
# PASS2_BALL=0

# --- Storage ---------------------------------------------------------------
# Where uploaded videos and the SQLite database live (default: ./data).
# DATA_DIR=
# local | s3
# STORAGE_BACKEND=local
# S3_VIDEO_BUCKET=
# AWS_REGION=us-east-2
# 0 = UI-only container that uploads to S3 and leaves processing to the worker.
# RUN_PROCESSING=1
